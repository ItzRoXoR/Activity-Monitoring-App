{
    "compilerOptions": {
        "target": "ES2024",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "declaration": false,
        "outDir": "./dist"
    },
    "include": [
        "src/**/*.ts"
    ]
}